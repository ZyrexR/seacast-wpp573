APP_NAME="SEACAST PRIGI"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://seacast.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# PostgreSQL 17 + PostGIS 3.6 Production Connection
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=seacast_prod
DB_USERNAME=cloudpanel_db_user
DB_PASSWORD=YOUR_STRONG_CLOUDPANEL_PASSWORD

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
CACHE_PREFIX=seacast_cache

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log

# GEE & Python Ingestion Pipeline Configuration (CloudPanel Hostinger VPS)
PYTHON_BINARY=/home/seacast-site/htdocs/seacast.id/venv/bin/python
EARTHENGINE_PROJECT=seca-513505
BMKG_BASE_URL=https://maritim.bmkg.go.id/marine2026-data/
GEE_CREDENTIALS_PATH=/home/seacast-site/.config/earthengine/credentials

PULSE_ENABLED=false
TELESCOPE_ENABLED=false
VITE_APP_NAME="${APP_NAME}"
